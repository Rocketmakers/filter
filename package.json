{
  "name": "filter-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --aggregate-output dev",
    "dev:tw": "pnpm -C packages/tailwind dev",
    "dev:mantine": "pnpm -C packages/mantine dev",
    "dev:stylex": "pnpm -C packages/stylex dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "codemod": "node .robo-codemod/cli.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@9.15.0",
  "config": {
    "commitizen": {
      "path": "./.robo-cz/cz.cjs"
    }
  }
}
