{
  "name": "@filter-builder/demo-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared demo data, integration code samples, and ORM schemas. Source-only (no build) — UI packages consume via Vite raw imports.",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./src/data/*",
    "./integrations/*": "./src/integrations/*",
    "./integrations/examples/*": "./src/integrations/examples/*"
  },
  "scripts": {
    "postinstall": "prisma generate --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "axios": "^1.17.0",
    "drizzle-orm": "^0.36.0",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "kysely": "^0.27.0",
    "lucide-react": "^1.17.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mongoose": "^8.0.0",
    "next": "^16.2.9",
    "react-redux": "^9.3.0",
    "react-router": "^7.17.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^18.x || ^19.x"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "prisma": "^6.0.0",
    "react": "^19.2.6"
  }
}
